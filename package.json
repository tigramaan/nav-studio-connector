{
  "name": "nav-studio-connector",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && npm run test:core",
    "test:core": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "bundle:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-windows.ps1",
    "validate:license": "node tools/validate-license.mjs",
    "validate:traceability": "node tools/validate-traceability.mjs",
    "qa:visual": "node tools/visual-qa.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
