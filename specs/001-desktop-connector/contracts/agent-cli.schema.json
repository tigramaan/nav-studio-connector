{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tigramaan/nav-studio-connector/specs/agent-cli.schema.json",
  "title": "Nav Studio Connector CLI envelope v1",
  "type": "object",
  "required": ["schema_version", "ok", "operation", "timestamp", "data"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "ok": { "type": "boolean" },
    "operation": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "data": {},
    "error": {
      "type": ["object", "null"],
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
